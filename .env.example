# Copy to .env and fill in. Never commit .env.

# LLM providers (https://console.groq.com/keys, https://openrouter.ai/keys).
# Groq alone is enough; OpenRouter is the fallback.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Bearer token clients must send to the API (generate with: openssl rand -hex 32).
ANVIL_API_KEY=

# Optional: override any config.yaml value, e.g.
# ANVIL__AGENT__MAX_STEPS=8
